FROM python:3.13-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.13-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app DEBUG=False
WORKDIR /app
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app
COPY --from=builder /opt/venv /opt/venv
COPY app/ ./app/
COPY server/ ./server/
COPY templates/ ./templates/
COPY static/ ./static/
COPY manage.py .
RUN mkdir -p logs staticfiles mediafiles \
    && chown -R app:app logs staticfiles mediafiles
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD python -c "import socket; socket.create_connection(('127.0.0.1',8000),3).close()"
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "server.asgi:application"]
